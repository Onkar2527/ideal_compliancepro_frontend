{
  "name": "compliance-pro-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "config:local": "copy src\\assets\\config\\config.local.json src\\assets\\config\\config.json",
    "config:prod": "copy src\\assets\\config\\config.prod.json src\\assets\\config\\config.json",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "serve": "ng serve",
    "build": "ng build --configuration production --output-path ./out/ng --base-href ./",
    "build:local": "ng build --configuration production --output-path ./out/ng --base-href ./"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.0.4",
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fastify/cors": "^11.2.0",
    "@primeuix/themes": "^1.2.1",
    "chart.js": "4.4.2",
    "primeclt": "^0.1.5",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@yao-pkg/pkg": "^5.16.1",
    "esbuild": "^0.24.2",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}